generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ───────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5) — Google 로그인용 표준 모델
// 데이터 격리는 안 함: User row 만들고 세션만 검증, 비즈니스 데이터에는 userId FK 없음
// ───────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")

  accounts Account[]
  sessions Session[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ───────────────────────────────────────────────────────────────────
// 비즈니스 모델
// ───────────────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(uuid())
  name      String
  nameEng   String?  @map("name_eng")
  corpCode  String?  @map("corp_code")
  stockCode String?  @map("stock_code")
  sector    String?
  isListed  Boolean  @default(true) @map("is_listed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  financialStatements FinancialStatement[]
  analyses            Analysis[]

  @@unique([name, corpCode], name: "name_corpCode")
  @@map("companies")
}

enum StatementSource {
  dart
  manual
  upload
}

enum StatementType {
  BS
  IS
  CF
}

model FinancialStatement {
  id            String          @id @default(uuid())
  companyId     String          @map("company_id")
  year          String
  source        StatementSource
  statementType StatementType   @map("statement_type")
  items         Json
  createdAt     DateTime        @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, year, source, statementType])
  @@map("financial_statements")
}

model Analysis {
  id            String   @id @default(uuid())
  companyId     String   @map("company_id")
  reportYear    String   @map("report_year")
  provider      String
  financialData Json     @map("financial_data")
  createdAt     DateTime @default(now()) @map("created_at")

  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  valuations Valuation[]

  @@unique([companyId, reportYear, provider], name: "companyId_reportYear_provider")
  @@index([companyId, reportYear])
  @@map("analyses")
}

model Valuation {
  id         String   @id @default(uuid())
  analysisId String   @map("analysis_id")
  provider   String
  result     Json
  createdAt  DateTime @default(now()) @map("created_at")

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@map("valuations")
}

// AI 호출 1회당 1 row. 어떤 사용자가 어떤 모델로 얼마를 태웠는지 추적.
// 일일 한도 가드 (lib/usage.ts) 가 (userEmail, createdAt) 으로 합산.
model UsageEvent {
  id           String   @id @default(uuid())
  userEmail    String?  @map("user_email")
  provider     String
  model        String?
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  costUsd      Float    @default(0) @map("cost_usd")
  source       String   // 'extract-server' | 'extract-client-anthropic' | 'valuation'
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userEmail, createdAt])
  @@index([createdAt])
  @@map("usage_events")
}
