# Anthropic Claude API Key (server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API Key (server-side only)
OPENAI_API_KEY=sk-...

# Google Gemini API Key (server-side only)
GEMINI_API_KEY=AIza...

# DeepSeek API Key (server-side only)
DEEPSEEK_API_KEY=sk-...

# AI Provider: 'anthropic', 'openai', 'gemini', or 'deepseek' (optional, default: anthropic)
AI_PROVIDER=anthropic

# AI Model overrides (optional, defaults shown)
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o
GEMINI_MODEL=gemini-2.0-flash
DEEPSEEK_MODEL=deepseek-chat

# DART OpenAPI Key (server-side only)
DART_API_KEY=...

# Python FastAPI server URL for PDF processing (server-side only)
PYTHON_API_URL=http://localhost:8000

# PostgreSQL Database (server-side only)
DATABASE_URL="postgresql://fa_user:fa_pass@localhost:5432/fa_db"

# Public app name (client-side)
NEXT_PUBLIC_APP_NAME=Financial Analysis System

# Auth.js (NextAuth v5)
# AUTH_SECRET: openssl rand -base64 32 로 생성한 랜덤 32바이트 (필수)
AUTH_SECRET=...
ALLOWED_EMAIL_DOMAIN=mnaikorea.com

# (선택) Google OAuth — 두 값 모두 설정되면 로그인 화면에 Google 버튼이 자동 노출.
# 미설정 시 이메일만 입력하는 임시 게이트 (도메인 검증만, 비밀번호 없음).
# AUTH_GOOGLE_ID=...apps.googleusercontent.com
# AUTH_GOOGLE_SECRET=...

# (선택) 사용자 1명당 1일 사용 한도 (USD). 미설정 시 $5.
# usage_events 테이블에 추정 비용을 누적하다가, 한도 도달 시 /api/extract,
# /api/valuation, /api/anthropic-config 가 429 응답.
# DAILY_USAGE_LIMIT_USD=5
